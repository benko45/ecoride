<title>choix de l'adresse d'arrivée</title>
<div id="page-container">
    <div class="d-flex justify-content-center my-4">
        <div class="form-container d-flex flex-row justify-content align-items-center rounded accessibility-border">
            <form method="POST" id="input-form" class="d-flex align-items-center background-light element-height-2">
                    <div class="vertical-align-center ms-2">
                        <a href="index.html" class="vertical-align-center m-0 me-0 text-decoration-none">
                            <i class="fa-solid fa-chevron-left custom-primary"></i>
                        </a>
                    </div>
                    <label for="address" class="form-label visually-hidden"></label>
                    <input type="text" class="form-control no-border txt-primary fs-13 fw-normal bg-transparent element-height-2 p-3" id="address" placeholder="Rue Blanche ou Café de la gare" autocomplete="off">
            </form>
        </div>
    </div>
    <div id="suggestions"></div>  
</div>